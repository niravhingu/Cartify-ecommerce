# Copy this file to ".env" and fill in real values. NEVER commit ".env".
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cartify
DB_USER=postgres
DB_PASSWORD=change_me

# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Frontend origin(s) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# Set to "production" when deploying (enables secure cookies)
NODE_ENV=development

# Only when running behind a reverse proxy (nginx, Render, Railway...)
# TRUST_PROXY=1
